# Supabase project configuration for the administrator mobile app.
# Copy to a local `.env` (never committed) or set per environment.
#
# These are PUBLIC, non-secret client values (the anon key is safe to ship in
# the app bundle; every real permission is enforced by RLS + is_admin() on
# the backend). Never put a service-role key or DB password in this file.
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
